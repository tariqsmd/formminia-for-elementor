<wpml-config>
    <elementor-widgets>
        <widget name="mtef">
            <fields>
                <field type="Form Title" editor_type="LINE">form_title</field>
                <field type="Button Text" editor_type="LINE">button_text</field>
                <field type="Label Name" editor_type="LINE">label_name</field>
                <field type="Placeholder Name" editor_type="LINE">placeholder_name</field>
                <field type="Label Email" editor_type="LINE">label_email</field>
                <field type="Placeholder Email" editor_type="LINE">placeholder_email</field>
                <field type="Label Phone" editor_type="LINE">label_phone</field>
                <field type="Placeholder Phone" editor_type="LINE">placeholder_phone</field>
                <field type="Label Website" editor_type="LINE">label_website</field>
                <field type="Placeholder Website" editor_type="LINE">placeholder_website</field>
                <field type="Label Subject" editor_type="LINE">label_subject</field>
                <field type="Placeholder Subject" editor_type="LINE">placeholder_subject</field>
                <field type="Label Message" editor_type="LINE">label_message</field>
                <field type="Placeholder Message" editor_type="LINE">placeholder_message</field>
                <field type="GDPR Text" editor_type="AREA">gdpr_text</field>
                <field type="Success Message" editor_type="AREA">success_message</field>
                <field type="Error Message" editor_type="AREA">error_message</field>
            </fields>
        </widget>
    </elementor-widgets>
</wpml-config>
